rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Allow authenticated users to upload and read their review images
    match /review-images/{allPaths=**} {
      allow read: if request.auth != null;
      // Unauthenticated creates: public form customers uploading review photos
      allow create: if request.resource.size <= 1468006
        && request.resource.contentType.matches('image/.*');
      allow update: if request.auth != null
        && request.resource.size <= 1468006
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }
    
    // Deny all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}